# Copy to .env and fill in. Never commit .env.

# Where the app is reachable. Locally: http://localhost:3000
# When hosted: https://hub.yourdomain.com  (OAuth callbacks must match this exactly)
BASE_URL=http://localhost:3000
PORT=3000

# Random 32+ character string used to sign login cookies.  `openssl rand -hex 32`
SESSION_SECRET=change-me

# Separate key for encrypting stored OAuth tokens (otherwise SESSION_SECRET is used). Rotating it logs every connection out.
TOKEN_KEY=

# Name-only test login for trying it alone. Only works when Google sign-in is empty AND BASE_URL is http. Set false before hosting.
ALLOW_DEV_LOGIN=true

# ---- Sign-in (Google) ----
# console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web)
# Authorised redirect URI:  {BASE_URL}/auth/google/callback
# Leave empty during friends-only testing to use the name-only dev login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Strava ----
# strava.com/settings/api → create app. Authorization Callback Domain = host of BASE_URL (e.g. localhost)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# ---- Google Health API (Fitbit Air, Pixel Watch) ----
# Replaces the old Fitbit Web API. Scopes are "restricted": Google must verify the app before
# anyone but test users can connect. Until then, Fitbit Air data arrives via the companion app
# (Health Connect) instead. Redirect URI: {BASE_URL}/auth/googlehealth/callback
GOOGLEHEALTH_CLIENT_ID=
GOOGLEHEALTH_CLIENT_SECRET=

# Your users' timezone for day boundaries until per-user timezones exist (IANA name).
TIMEZONE=Asia/Kolkata

# Hevy needs no app registration: each user pastes their own key (Hevy Pro → Settings → Developer).
